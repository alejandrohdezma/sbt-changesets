# Initialize git repo and create initial commit with all files
$ exec git init
$ exec git config user.email "test@test.com"
$ exec git config user.name "Test"
$ exec git add .
$ exec git commit --no-gpg-sign -m "Initial commit"

# Default: a change to `base` affects only its compile-scope dependent, not the test-scoped one
> changesetMatrix validate
$ must-mirror target/changeset/matrix.json expected/matrix-default.json

# Opt-in: also treat test-scope dependents as affected
> set ThisBuild / changesetAffectedScopes := Seq("compile", "test")
> changesetMatrix validate
$ must-mirror target/changeset/matrix.json expected/matrix-include.json
