# Initialize git repo and create initial commit with all files
$ exec git init
$ exec git config user.email "test@test.com"
$ exec git config user.name "Test"
$ exec git add .
$ exec git commit --no-gpg-sign -m "Initial commit"

# An untracked test-only change does NOT require a changeset under the default scopes (compile),
# but the module is still validated - as a `validate-only` row, since it won't be released. The
# `changesetAlwaysBump` module stays out: it rides release trains, and this change starts none.
$ copy-file changes/TestOnly.scala modules/foo/src/test/scala/com/example/TestOnly.scala
> changesetMatrix validate
$ must-mirror target/changeset/matrix.json expected/matrix-test-only.json

# Opting `test` scope in makes the same change require a changeset (foo has none) -> fails
> set ThisBuild / changesetAffectedScopes := Seq("compile", "test")
-> changesetMatrix validate

# Back to the default scopes: the test-only change is ignored again
> set ThisBuild / changesetAffectedScopes := Seq("compile")
> changesetMatrix validate

# A src/main change always requires a changeset (foo has none) -> fails
$ copy-file changes/MainChange.scala modules/foo/src/main/scala/com/example/MainChange.scala
-> changesetMatrix validate
