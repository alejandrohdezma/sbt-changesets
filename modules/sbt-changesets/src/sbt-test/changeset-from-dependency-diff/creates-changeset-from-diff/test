# Initialize git repo (required by the plugin)
$ exec git init
$ exec git config user.email "test@test.com"
$ exec git config user.name "Test"
$ exec git add .
$ exec git commit --no-gpg-sign -m "Initial commit"

# Copy the dependency diff file to the expected location
$ mkdir target/sbt-dependencies
$ copy-file changes/.sbt-dependency-diff target/sbt-dependencies/.sbt-dependency-diff

# Default `changesetAffectedScopes := Seq("compile")`:
#   - module-a (compile update) -> affected
#   - module-b (test-only add)  -> NOT affected
#   - module-c (no configuration field; legacy diffs from older sbt-dependencies default to "compile") -> affected
> changesetFromDependencyDiff
$ exists .changeset/dependency-updates.md
$ exec diff -u expected-changeset .changeset/dependency-updates.md

# Opt-in to also treat test-scope updates as affected: module-b now appears too.
$ delete .changeset/dependency-updates.md
> set ThisBuild / changesetAffectedScopes := Seq("compile", "test")
> changesetFromDependencyDiff
$ exists .changeset/dependency-updates.md
$ exec diff -u expected-changeset-with-test-scope .changeset/dependency-updates.md
