# Initialize git repo and create initial commit with all files
$ exec git init
$ exec git config user.email "test@test.com"
$ exec git config user.name "Test"
$ exec git add .
$ exec git commit --no-gpg-sign -m "Initial commit"

# `module-a` carries a patch bump; `module-b` is `validate-only`, so it is consumed
# without touching its VERSION or writing it a CHANGELOG
> changesetVersion

$ must-mirror modules/module-a/VERSION expected/module-a-version
$ must-mirror modules/module-b/VERSION expected/module-b-version
$ exists modules/module-a/CHANGELOG.md
-$ exists modules/module-b/CHANGELOG.md
-$ exists .changeset/mixed.md

# A changeset holding nothing but `validate-only` entries releases nothing at all
$ copy-file changes/validate-only.md .changeset/validate-only.md
> changesetVersion

$ must-mirror modules/module-a/VERSION expected/module-a-version
$ must-mirror modules/module-b/VERSION expected/module-b-version
-$ exists modules/module-b/CHANGELOG.md
-$ exists .changeset/validate-only.md
