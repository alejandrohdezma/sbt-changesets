# Initialize git repo and create initial commit with all files
$ exec git init
$ exec git config user.email "test@test.com"
$ exec git config user.name "Test"
$ exec git add .
$ exec git commit --no-gpg-sign -m "Initial commit"

# Apply pending changesets: module-a (minor) and module-b (patch) are bumped
# and my-bom rides the same train via `changesetAlwaysBump`
> changesetVersion

$ must-mirror modules/module-a/VERSION expected/module-a-version
$ must-mirror modules/module-b/VERSION expected/module-b-version
$ must-mirror modules/my-bom/VERSION expected/my-bom-version
$ must-mirror modules/my-bom/CHANGELOG.md expected/my-bom-changelog

# With no pending changesets, an always-bumped module never starts a train
> changesetVersion

$ must-mirror modules/my-bom/VERSION expected/my-bom-version
$ must-mirror modules/my-bom/CHANGELOG.md expected/my-bom-changelog
